# Plantilla de referencia: Spring Boot no carga archivos .env automáticamente.
# Define estos valores en el entorno del proceso; ver las instrucciones PowerShell del README.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orman
DB_SSL_MODE=disable
DB_USERNAME=postgres
DB_PASSWORD=
# Obligatorio: configura un secreto local estable de al menos 32 bytes,
# distinto del valor de JWT_SECRET usado por producción.
JWT_SECRET=
JWT_ISSUER=orman-backend
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
REFRESH_COOKIE_NAME=orman_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
ORMAN_FRONTEND_URL=http://localhost:4200
PORT=9090

# Opcionales: habilítalos/configúralos solo si se utilizan.
ORMAN_STORAGE_PROVIDER=local
ORMAN_FIREBASE_ENABLED=false
# ORMAN_FIREBASE_PROJECT_ID=
# ORMAN_FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# ORMAN_R2_ENDPOINT=
# ORMAN_R2_BUCKET=
# ORMAN_R2_ACCESS_KEY_ID=
# ORMAN_R2_SECRET_ACCESS_KEY=
