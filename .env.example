# Este archivo puede versionarse; no contiene credenciales reales.
# Copia manualmente estas claves a .env local si lo necesitas; .env está ignorado por Git.
# application.yml lo importa opcionalmente como archivo .properties. Las variables
# de entorno del sistema tienen prioridad sobre .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orman
DB_USERNAME=postgres
DB_PASSWORD=<contrasena>
# Obligatorio: pega aquí un valor local generado de al menos 32 bytes.
JWT_SECRET=
JWT_ISSUER=orman-backend
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
REFRESH_COOKIE_NAME=orman_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
# Origen exacto de Angular; se pueden configurar varios mediante YAML/perfil.
ORMAN_FRONTEND_URL=http://localhost:4200
