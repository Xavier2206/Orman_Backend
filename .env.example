# Este archivo puede versionarse; no contiene credenciales reales.
# No crees ni versiones un archivo .env real: está ignorado por Git.
# Spring Boot no carga automáticamente .env; configura estas variables en IntelliJ,
# PowerShell, CMD o el entorno de ejecución antes de iniciar la aplicación.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orman
DB_USERNAME=postgres
DB_PASSWORD=<contrasena>
